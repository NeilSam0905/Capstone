ustore.db
# WAL sidecars (backend/db.py opens the database in WAL mode); they exist
# only while something has it open, and are machine-local like the db itself.
ustore.db-wal
ustore.db-shm
# Any copy of the database under another name - `ustore.db.pre_contract`,
# `ustore.db.pre_rebuild-2026-09-30`, whatever the next one is called. The bare
# `ustore.db` above does not match these, so before this line a backup left
# anywhere in the tree was stageable: `git add -A -- data/` picked up 10 MB of
# real sales, prices and supplier names. No slash, so it matches at any depth,
# which is where these actually get left (data/pre_contract/).
ustore.db.*
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# local environment config (backend/.env: Power BI embed URL, etc.) - not
# sensitive today, but nothing should have to remember that before it is
.env
.env.local

# raw inventory workbook (~131MB, mostly embedded product photos) - too big for
# GitHub's 100MB limit; USTore_inventory_excel_long.csv has the usable data
Copy of USTORE INVENTORY REPORT (1).xlsx

# real client tally-sheet workbooks - sensitive (supplier names, prices, sales
# volumes) and deliberately not committed. step0 reads them locally; every step
# after it reads only data/*.csv, which IS committed.
rawdata/

# Store data is committed ONLY in encrypted form, under vault/ (scripts/vault.py).
# The plain files below stay on each machine: `python scripts/vault.py unlock`
# restores them from vault/, `lock` re-encrypts after changes.
data/*.csv
data/*.xlsx
docs/*.csv
/*.xlsx
.vault_state.json
*.vaulttmp
