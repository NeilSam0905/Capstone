table Fact_Sales
	lineageTag: 4f258b19-cfd8-4a58-a628-127098bd8aad

	measure 'Units Sold' = SUM(Fact_Sales[quantity_sold])
		formatString: 0
		lineageTag: e7624129-8e36-44d4-8406-915c0f73f4a2

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Line Total (ref)' =
			
			SUMX(Fact_Sales, Fact_Sales[quantity_sold] * RELATED(Dim_Product[unit_price_php]))
		formatString: #,0.00\ "₱";-#,0.00\ "₱";#,0.00\ "₱"
		lineageTag: 3f286580-88e5-40e8-963e-e5bd0e1e31ff

		annotation PBI_FormatHint = {"currencyCulture":"es-PH"}

	measure 'Avg Daily Units' =
			
			DIVIDE(SUM(Fact_Sales[quantity_sold]), DISTINCTCOUNT(Fact_Sales[date_id]))
		lineageTag: 98953222-dcc5-4b76-85fb-c07d4eb3d181

		annotation PBI_FormatHint = {"isGeneralNumber":true}

