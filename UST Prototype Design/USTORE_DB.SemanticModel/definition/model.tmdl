model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-PH
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["UstoreDbPath","Dim_Date","Dim_Parameters","Dim_Product","Result_Prescriptive","Result_Forecast_Metrics","Result_Forecast","Fact_Sales"]

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Date
ref table Dim_Parameters
ref table Dim_Product
ref table Result_Prescriptive
ref table Result_Forecast_Metrics
ref table Result_Forecast
ref table Fact_Sales

ref cultureInfo en-US

